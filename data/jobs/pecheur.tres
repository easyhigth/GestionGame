[gd_resource type="Resource" script_class="JobData" format=3]

[ext_resource type="Script" path="res://scripts/data/job_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/data/item_data.gd" id="2"]
[ext_resource type="Resource" path="res://data/items/canne_peche.tres" id="it_canne_peche"]
[ext_resource type="Resource" path="res://data/items/truite.tres" id="it_truite"]

[resource]
script = ExtResource("1")
display_name = "Pêcheur"
description = "Patient au bord de l'eau, il sait où mordent les poissons. Commence avec une canne et quelques prises."
