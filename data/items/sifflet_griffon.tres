[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://scripts/data/item_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "sifflet_griffon"
display_name = "Sifflet du griffon"
description = "Le sifflet d'os que Vharok t'a confié. Prends-le en main ({hand_toggle} ou {build_bar}), puis {place_click} : le griffon des cimes se pose près de toi. {interact} pour monter ; en vol, {jump} pour monter, {dig} pour descendre, E pour se poser."
rarity = 4
max_stack = 1
