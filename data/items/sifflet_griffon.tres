[resource]
script = ExtResource("1")
id = "sifflet_griffon"
display_name = "Sifflet du griffon"
description = "Le sifflet d'os que Vharok t'a confié. Choisis-le (C) et appuie sur V : le griffon des cimes se pose près de toi. E pour monter ; en vol, Saut pour monter, Creuser pour descendre, E pour se poser."
rarity = 4
max_stack = 1
