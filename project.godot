; Fichier de configuration du projet Godot.
; Modifiable depuis Projet > Paramètres du projet.

config_version=5

[application]

config/name="L'Éveil du Royaume"
config/description="Action-RPG 3D voxel en monde ouvert vu de dessus avec construction de royaume."
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Items="*res://scripts/items/item_database.gd"
TimeFX="*res://scripts/combat/time_fx.gd"
Access="*res://scripts/ui/accessibility.gd"
I18n="*res://scripts/ui/i18n.gd"
GameState="*res://scripts/hero/game_state.gd"
Sound="*res://scripts/audio/sound.gd"
SaveGame="*res://scripts/save/save_game.gd"
UiStyle="*res://scripts/ui/ui_theme.gd"
LabelLod="*res://scripts/ui/label_lod.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1920
window/size/window_height_override=1080
window/size/mode=2
window/stretch/mode="canvas_items"

