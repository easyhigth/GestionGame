; Fichier de configuration du projet Godot.
; Modifiable depuis Projet > Paramètres du projet.

config_version=5

[application]

config/name="Jeu de gestion"
config/description="Action-RPG 3D voxel en monde ouvert vu de dessus avec construction de royaume."
run/main_scene="res://scenes/ui/character_creator.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Items="*res://scripts/items/item_database.gd"
TimeFX="*res://scripts/combat/time_fx.gd"
GameState="*res://scripts/hero/game_state.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/size/mode=2
window/stretch/mode="canvas_items"

