		"end": [["lysandre", "Écoute ce bruit ! C'est le son de l'or. Voici ta part, et un flacon rare que m'a vendu un marchand démon. Ne pose pas de questions."]]},
	# ---------------------------------------------------------------- Zzar
	{"id": "zzar_a", "npc": "zzar", "after": "zzar_2", "title": "La gelée royale", "text": "Zzar veut échanger : apporte 10 baies et 5 laitages (lait).",
		"type": "item", "item": "baies", "n": 10, "item2": "lait", "n2": 5, "reward": {"items": [["ecaille_dragon", 2]], "xp": 120},
		"start": [["zzar", "Zzz. La Ruche veut goûter les nourritures des mammifères. Dix baies, cinq laits. La Ruche paiera."]],
		"wait": [["zzar", "Zzz. Baies. Lait. La Ruche attend."]],
		"end": [["zzar", "Zzz... intéressant. La Ruche approuve le lait. Voici des écailles, trouvées dans le sable."]]},
	{"id": "zzar_b", "npc": "zzar", "after": "fin", "title": "L'empereur des sables", "text": "Zzar veut la fin des scorpions : vaincs 10 scorpions.",
		"type": "kill", "enemies": ["scorpion"], "n": 10, "reward": {"items": [["ecaille_dragon", 4], ["sang_demon", 1]], "xp": 450},
		"start": [["zzar", "Zzz. Les scorpions reviennent, plus gros, plus nombreux. La Ruche veut qu'ils disparaissent. Dix."]],
		"wait": [["zzar", "Zzz. La Ruche compte encore des scorpions."]],
		"end": [["zzar", "Zzz. Le désert est calme. La Ruche offre ses trésors au mammifère. Le mammifère est... apprécié."]]},
	# ---------------------------------------------------------------- Gorvak
	{"id": "gorvak_a", "npc": "gorvak", "after": "gorvak_ble", "title": "Les champs de la Horde", "text": "Gorvak veut des outils pour ses fermiers : apporte 3 houes.",
		"type": "item", "item": "houe", "n": 3, "reward": {"items": [["hache_horde", 1]], "xp": 120},
		"start": [["gorvak", "Mes orcs labourent avec leurs haches. Ça marche mal. Trois houes, et on fera pousser plus de blé que tout le royaume."]],
		"wait": [["gorvak", "Trois houes. Deux bouts de bois, deux pierres. Même un orc sait faire. Enfin, presque."]],
		"end": [["gorvak", "Les champs sont magnifiques. Prends la hache de mon père : on n'en a plus besoin pour labourer."]]},
	{"id": "gorvak_b", "npc": "gorvak", "after": "fin", "title": "Les pillards d'hier", "text": "Des gobelins pillards refusent la paix : vaincs 10 gobelins pillards ou orcs brutes.",
		"type": "kill", "enemies": ["gobelin_pillard", "orc_brute"], "n": 10, "reward": {"items": [["mithril_brut", 4], ["lingot_or", 3]], "xp": 450},
		"start": [["gorvak", "Certains de mes anciens frères pillent encore. Ils disent que je suis devenu un fermier. C'est vrai. Mais je sais encore me battre. Aide-moi."]],
		"wait": [["gorvak", "Ils sont encore là, à piller les fermes des autres."]],
		"end": [["gorvak", "Les survivants ont demandé à rejoindre nos champs. La paix, ça se gagne aussi. Tiens, leur butin."]]},
	# ---------------------------------------------------------------- Sylve
	{"id": "sylve_a", "npc": "sylve", "after": "sylve", "title": "Le jardin des dryades", "text": "Sylve veut un jardin : apporte 10 carottes et 10 pommes de terre.",
		"type": "item", "item": "carotte", "n": 10, "item2": "pomme_de_terre", "n2": 10, "reward": {"items": [["larme_esprit", 2]], "xp": 120},
		"start": [["sylve", "Les arbres aiment les jardins. Apporte-moi des carottes et des pommes de terre, je les planterai au pied des chênes."]],
		"wait": [["sylve", "Dix carottes, dix pommes de terre. La terre attend."]],
		"end": [["sylve", "La terre est heureuse. Voici deux larmes des arbres, cueillies au lever du soleil."]]},
	{"id": "sylve_b", "npc": "sylve", "after": "fin", "title": "Les dryades corrompues", "text": "Sylve veut sauver ses sœurs : vaincs 6 dryades corrompues.",
		"type": "kill", "enemies": ["dryade_corrompue"], "n": 6, "reward": {"items": [["larme_esprit", 3], ["cristal_aube", 1]], "xp": 480},
		"start": [["sylve", "Mes sœurs du bois enchanté ont bu la Brume. Elles souffrent. Libère-les, je t'en prie."]],
		"wait": [["sylve", "Elles pleurent encore dans les bois."]],
		"end": [["sylve", "Elles dorment enfin. Les arbres te remercient. Prends ceci, c'est leur dernier présent."]]},
	# ---------------------------------------------------------------- Aldéric
	{"id": "alderic_a", "npc": "alderic", "after": "alderic_2", "title": "L'honneur des chevaliers", "text": "Aldéric veut rééquiper l'ordre : apporte 2 armures de fer et 2 boucliers de fer.",
		"type": "item", "item": "iron_armor", "n": 2, "item2": "shield_iron", "n2": 2, "reward": {"items": [["bouclier_hauterive", 1]], "xp": 150},
		"start": [["alderic", "Mon ordre renaît, avec des volontaires de tous les peuples. Il leur faut des armures. Deux armures, deux boucliers, pour commencer."]],
		"wait": [["alderic", "Deux armures de fer, deux boucliers. L'enclume est ton amie."]],
		"end": [["alderic", "Le nouvel ordre de l'Aube a ses premiers chevaliers : un gobelin, un orc et une naine. Le roi va faire une tête. Tiens, un bouclier d'Hauterive."]]},
	{"id": "alderic_b", "npc": "alderic", "after": "fin", "title": "Les derniers templiers", "text": "Des templiers morts-vivants hantent les ruines : vaincs 10 squelettes.",
		"type": "kill", "enemies": ["squelette", "seigneur_squelette"], "n": 10, "reward": {"items": [["fragment_brume", 4], ["orichalque", 1]], "xp": 480},
		"start": [["alderic", "Des templiers de Morvain errent encore dans les ruines, morts mais debout. Mes anciens frères, peut-être. Il faut les laisser reposer."]],
		"wait": [["alderic", "Il en reste. J'entends leurs armures grincer la nuit."]],
		"end": [["alderic", "Ils reposent. Merci, Éveillé. Voici ce qu'ils gardaient, dans la crypte."]]},
	# ---------------------------------------------------------------- Edmond
	{"id": "edmond_a", "npc": "edmond", "after": "traite", "title": "Le tribut de l'amitié", "text": "Edmond veut une route pavée entre vos pays : apporte 30 blocs de pierre polie.",
		"type": "item", "item": "bloc_pierre_polie", "n": 30, "reward": {"items": [["lingot_or", 4], ["piece_or", 200]], "xp": 150},
		"start": [["edmond", "Une route pavée entre Hauterive et ta nation ! Les marchands en rêvent. Il me faut de la pierre polie, trente blocs."]],
		"wait": [["edmond", "Trente blocs de pierre polie, mon ami. La route attend."]],
		"end": [["edmond", "La route royale est inaugurée ! Le commerce va exploser. Voici le paiement de la couronne."]]},
	{"id": "edmond_b", "npc": "edmond", "after": "fin", "title": "La paix des royaumes", "text": "Edmond veut une ambassade : construis une salle du trône et une taverne.",
		"type": "room", "room": "taverne", "reward": {"items": [["couronne_pactes", 1], ["piece_or", 500]], "xp": 500},
		"start": [["edmond", "Une ambassade a besoin d'un lieu où l'on boit ensemble. Construis une taverne, et Hauterive y enverra son ambassadeur."]],
		"wait": [["edmond", "Une taverne. Des tables, des tonneaux, et de la bonne humeur."]],
		"end": [["edmond", "L'ambassadeur est ravi : il a déjà perdu trois parties de dés contre Glou. Voici un présent de la couronne."]]},
	# ---------------------------------------------------------------- Séléné
	{"id": "selene_a", "npc": "selene", "after": "selene_2", "title": "Les roses de minuit", "text": "Séléné veut des fleurs pour la tombe de Caël : apporte 10 fibres et 5 lanternes.",
		"type": "item", "item": "fiber", "n": 10, "item2": "lanterne", "n2": 5, "reward": {"items": [["sang_demon", 2]], "xp": 150},
		"start": [["selene", "Je veux lui faire un jardin de lumière. Des fibres pour tresser des couronnes, et des lanternes pour que la nuit ne soit plus jamais noire."]],
		"wait": [["selene", "Dix fibres, cinq lanternes. Je sais, c'est sentimental. Tais-toi."]],
		"end": [["selene", "C'est beau. Il aurait aimé. Tiens, un flacon de ma réserve. Ne demande pas d'où il vient."]]},
	{"id": "selene_b", "npc": "selene", "after": "fin", "title": "Les démons de la nuit", "text": "Des démons profitent de la chute de Caël : vaincs 8 démons.",
		"type": "kill", "enemies": ["demon", "seigneur_demon"], "n": 8, "reward": {"items": [["sang_demon", 3], ["orichalque", 1]], "xp": 500},
		"start": [["selene", "Les démons que Caël tenait en laisse sont libres. Ils chassent sur mes terres. Chassons-les ensemble, petit Éveillé."]],
		"wait": [["selene", "Il en reste. La nuit en est pleine."]],
		"end": [["selene", "Mes terres sont calmes. Merci. Prends ceci, arraché au plus vieux d'entre eux."]]},
	# ---------------------------------------------------------------- Vharok
	{"id": "vharok_a", "npc": "vharok", "after": "vharok_2", "title": "La chaleur de l'œuf", "text": "Vharok veut garder l'œuf au chaud : apporte 20 bûches et 5 torches.",
		"type": "item", "item": "wood", "n": 20, "item2": "torche", "n2": 5, "reward": {"items": [["ecaille_dragon", 4]], "xp": 150},
		"start": [["vharok", "L'œuf est tiède, mais pas assez. Il lui faut un feu éternel. Du bois et des torches, sang-chaud."]],
		"wait": [["vharok", "Vingt bûches, cinq torches. Vite, il refroidit."]],
		"end": [["vharok", "Il est chaud. Il bouge, même. Prends ces écailles : ce sont celles de sa mère."]]},
	{"id": "vharok_b", "npc": "vharok", "after": "fin", "title": "Les salamandres ardentes", "text": "Vharok veut protéger le nid : vaincs 8 salamandres ou slimes de magma.",
		"type": "kill", "enemies": ["salamandre", "slime_magma"], "n": 8, "reward": {"items": [["ecaille_dragon", 6], ["orichalque", 1]], "xp": 500},
		"start": [["vharok", "Des salamandres rôdent autour du nid, attirées par sa chaleur. Elles mangeraient l'œuf. Abats-les."]],
		"wait": [["vharok", "Il en reste. Le nid tremble."]],
		"end": [["vharok", "L'œuf a éclos. Un petit dragon, sang-chaud. Le premier depuis trois siècles. Il porte ton odeur. Prends ce trésor du nid."]]},
	# ---------------------------------------------------------------- Aurèle
	{"id": "aurele_a", "npc": "aurele", "after": "aurele_2", "title": "Les prières du Ciel", "text": "Aurèle veut un temple digne : construis un second temple.",
		"type": "room", "room": "temple", "count": 2, "reward": {"items": [["larme_esprit", 3]], "xp": 200},
		"start": [["aurele", "Le Ciel observe ta nation. Un second temple lui montrerait que les peuples prient ensemble."]],
		"wait": [["aurele", "Un autel, deux bougeoirs, une pièce fermée. Le Ciel est patient."]],
		"end": [["aurele", "Le Ciel est satisfait. Il m'autorise à rester parmi vous. Prends ces larmes, bénies."]]},
	{"id": "aurele_b", "npc": "aurele", "after": "fin", "title": "L'épreuve des cieux", "text": "Aurèle veut mesurer ta puissance : atteins le niveau 30.",
		"type": "level", "n": 30, "reward": {"items": [["cristal_aube", 2], ["orichalque", 1]], "xp": 800},
		"start": [["aurele", "Tu as vaincu Caël. Mais es-tu prêt pour ce qui viendra ? Deviens plus fort encore. Niveau trente, Éveillé."]],
		"wait": [["aurele", "Continue de grandir. Le Ciel t'observe."]],
		"end": [["aurele", "Tu es digne d'un séraphin. Voici les dernières lumières du premier Cœur."]]},
]
