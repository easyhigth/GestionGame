class_name SideQuestData
extends RefCounted
## Quêtes secondaires des personnages de l'histoire (deux par personnage) : la première s'ouvre après
## leur arc dans l'histoire, la seconde après la fin de l'histoire (contenu de fin de partie).
##
## Champs : id, npc, after (étape de l'histoire à avoir passée ; « fin » = histoire finie), title, text (journal),
## type : « item » (apporter item × n), « kill » (vaincre n monstres parmi `enemies`, n'importe où),
##        « boss » (vaincre n grandes bêtes de donjon), « tame » (apprivoiser n familiers),
##        « evolve » (faire évoluer n habitants par le nom), « have » (posséder un de ces objets : `items`) ;
## reward : {items: [[id, n]], xp, gold} ; start / end : pages de dialogue ; wait : ce qu'il dit en attendant.

const QUESTS := [
	# ---------------------------------------------------------------- Orvane
	{"id": "orvane_a", "npc": "orvane", "after": "orvane_2", "title": "Les graines du vieil arbre", "text": "Orvane veut replanter la forêt de sa jeunesse : apporte-lui 20 bûches et 10 fibres.",
		"type": "item", "item": "wood", "n": 20, "item2": "fiber", "n2": 10, "reward": {"items": [["larme_esprit", 1]], "xp": 80},
		"start": [["orvane", "Trois cents ans sans voir pousser un arbre... Apporte-moi du bois et des fibres, revenant. Je leur apprendrai à redevenir forêt."]],
		"wait": [["orvane", "Vingt bûches, dix fibres. Le bois se souvient de la forêt, les fibres de la terre."]],
		"end": [["orvane", "Regarde : les racines reprennent déjà. Tiens, une larme de mon ancien cristal. Je n'en ai plus besoin."]]},
	{"id": "orvane_b", "npc": "orvane", "after": "fin", "title": "Les cendres de Caël", "text": "Orvane veut purger la Brume qui reste : vaincs 3 grandes bêtes de donjon.",
		"type": "boss", "n": 3, "reward": {"items": [["orichalque", 1], ["cristal_aube", 1]], "xp": 600},
		"start": [["orvane", "La Brume de Caël s'est dispersée, mais des lambeaux se sont réfugiés dans les donjons. Les grandes bêtes s'en nourrissent encore."], ["orvane", "Abats-en trois, et le monde respirera enfin."]],
		"wait": [["orvane", "Trois grandes bêtes. Je sens encore la Brume dans leurs antres."]],
		"end": [["orvane", "C'est fini. Pour de bon, cette fois. Prends ce que Caël m'avait confié autrefois : de l'orichalque et un cristal d'aube."]]},
	# ---------------------------------------------------------------- Glou
	{"id": "glou_a", "npc": "glou", "after": "glou_2", "title": "Le grand festin de Glou", "text": "Glou veut goûter à tout : apporte-lui 5 ragoûts.",
		"type": "item", "item": "ragout", "n": 5, "reward": {"items": [["piece_or", 120]], "xp": 60},
		"start": [["glou", "Blup ! Glou a entendu parler du RAGOÛT. Glou veut du ragoût ! Cinq ragoûts ! Glou partage... un peu."]],
		"wait": [["glou", "Ragoût ? Ragoût ? ... Pas encore ragoût. Blup."]],
		"end": [["glou", "RAGOÛT ! Glou heureux ! Glou a trouvé ça dans son ventre, tiens. Pièces brillantes. Pas bonnes à manger."]]},
	{"id": "glou_b", "npc": "glou", "after": "fin", "title": "Glou veut évoluer", "text": "Glou veut devenir grand comme les autres : fais évoluer 2 habitants par le Pacte, pour lui montrer.",
		"type": "evolve", "n": 2, "reward": {"items": [["sang_demon", 1], ["larme_esprit", 2]], "xp": 400},
		"start": [["glou", "Pip est devenu grand. Les autres aussi. Glou veut voir comment on fait ! Montre à Glou ! Deux fois !"]],
		"wait": [["glou", "Nommer quelqu'un, et pouf, il grandit ! Glou veut voir ça encore."]],
		"end": [["glou", "Glou a compris ! Il faut des amis pour grandir. Glou a plein d'amis. Tiens, cadeaux trouvés dans des monstres. Glou les a pas mangés. Presque."]]},
	# ---------------------------------------------------------------- Grik
	{"id": "grik_a", "npc": "grik", "after": "grik_2", "title": "Les réserves de l'hiver", "text": "Grik veut remplir les greniers : apporte 20 bottes de blé.",
		"type": "item", "item": "ble", "n": 20, "reward": {"items": [["graines_ble", 20], ["piece_or", 80]], "xp": 90},
		"start": [["grik", "Les gobelins n'ont jamais eu de réserves. On mangeait ce qu'on trouvait. Cette année, je veux un grenier plein pour l'hiver !"]],
		"wait": [["grik", "Vingt bottes de blé. Les champs, la houe, les graines... Pip t'expliquera, il adore ça."]],
		"end": [["grik", "Un grenier plein ! Mon grand-père pleurerait de joie. Tiens, des graines de la meilleure récolte, et un peu d'or."]]},
	{"id": "grik_b", "npc": "grik", "after": "fin", "title": "Le conseil des anciens", "text": "Grik veut un village digne de la nation : rassemble 20 habitants.",
		"type": "have", "items": [], "pop": 20, "reward": {"items": [["lingot_or", 5], ["lingot_mithril", 2]], "xp": 500},
		"start": [["grik", "Une nation, c'est bien. Une nation peuplée, c'est mieux ! Vingt habitants, et je convoque le premier conseil des anciens."]],
		"wait": [["grik", "Il nous faut plus de monde. Recrute des voyageurs, construis des maisons !"]],
		"end": [["grik", "Vingt ! Le conseil des anciens est ouvert. Et comme doyen, je t'offre le trésor de la tribu. On l'a gardé trois générations."]]},
	# ---------------------------------------------------------------- Pip
	{"id": "pip_a", "npc": "pip", "after": "pip_eveil", "title": "La chasse du hobgobelin", "text": "Pip veut prouver sa nouvelle force : vaincs 8 loups ou sangliers avec lui.",
		"type": "kill", "enemies": ["loup", "loup_alpha", "loup_givre", "sanglier"], "n": 8, "reward": {"items": [["croc_meute", 1], ["leather", 10]], "xp": 150},
		"start": [["pip", "Je suis GRAND maintenant ! Allons chasser ! Huit bêtes, loups ou sangliers, et je raconterai ça à tout le village !"]],
		"wait": [["pip", "Encore ! Encore ! J'ai compté, il en manque !"]],
		"end": [["pip", "On est les meilleurs chasseurs du monde ! Tiens, j'ai taillé un croc pour toi, comme celui d'Ulric."]]},
	{"id": "pip_b", "npc": "pip", "after": "fin", "title": "Un ami à quatre pattes", "text": "Pip rêve d'un compagnon : apprivoise 2 familiers par le Pacte.",
		"type": "tame", "n": 2, "reward": {"items": [["ecaille_dragon", 2], ["piece_or", 200]], "xp": 400},
		"start": [["pip", "Tu as vu tes familiers ? Ils sont trop forts ! Moi aussi je veux apprendre. Montre-moi comment tu fais, deux fois !"]],
		"wait": [["pip", "Un monstre affaibli, E, et le Pacte ! C'est ça ? Montre-moi encore !"]],
		"end": [["pip", "J'ai tout noté ! Un jour, j'aurai mon propre loup. Tiens, des écailles que j'ai trouvées en éclaireur."]]},
	# ---------------------------------------------------------------- Ulric
	{"id": "ulric_a", "npc": "ulric", "after": "ulric", "title": "Les cerfs perdus", "text": "Ulric veut nourrir sa meute : apporte 10 viandes crues.",
		"type": "item", "item": "viande_crue", "n": 10, "reward": {"items": [["leather", 12], ["piece_or", 60]], "xp": 90},
		"start": [["ulric", "Les petits de la meute ont faim, et le gibier revient lentement. Dix viandes, Éveillé, et la meute s'en souviendra."]],
		"wait": [["ulric", "Dix viandes. La meute attend."]],
		"end": [["ulric", "La meute mange. Prends ces peaux, elles viennent des anciens chasseurs."]]},
	{"id": "ulric_b", "npc": "ulric", "after": "fin", "title": "Les loups de Brume", "text": "Des loups corrompus rôdent : vaincs 12 loups (gris, alpha ou givre).",
		"type": "kill", "enemies": ["loup", "loup_alpha", "loup_givre"], "n": 12, "reward": {"items": [["mithril_brut", 4], ["larme_esprit", 1]], "xp": 450},
		"start": [["ulric", "Certains loups ont bu la Brume. Ils ne sont plus des nôtres. Il faut les libérer. Douze, Éveillé. Cela me déchire, mais il le faut."]],
		"wait": [["ulric", "Il en reste. Je les entends hurler faux."]],
		"end": [["ulric", "Ils reposent en paix. Prends ce mithril, trouvé dans leurs tanières. Le Pacte des loups est éternel."]]},
	# ---------------------------------------------------------------- Maëlle
	{"id": "maelle_a", "npc": "maelle", "after": "maelle_2", "title": "La bibliothèque d'Émeraude", "text": "Maëlle veut classer ses notes : construis une bibliothèque.",
