		"wait": [["kaede", "Ma lame n'a pas fini son travail."]],
		"end": [["kaede", "Les villages des hauteurs sont en sécurité. Merci, ami. Tiens, leur butin."]]},
	# ---------------------------------------------------------------- Kaïa
	{"id": "kaia_a", "npc": "kaia", "after": "kaia_3", "title": "Le courrier des nuages", "text": "Kaïa a perdu ses lettres : vaincs 6 harpies voleuses.",
