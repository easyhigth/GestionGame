		"start": [["maelle", "J'écris une encyclopédie. Mais il me manque des obélisques, ceux des contrées les plus lointaines. Tu veux bien les éveiller tous ?"]],
		"wait": [["maelle", "Il reste des pierres endormies. La carte (M) te les montre."]],
		"end": [["maelle", "Tous ! L'encyclopédie est complète. Tiens, un cristal d'aube : le réseau en a fait naître un quand le dernier obélisque s'est allumé."]]},
	# ---------------------------------------------------------------- Liora
	{"id": "liora_a", "npc": "liora", "after": "liora_pain", "title": "Des gâteaux pour les fées", "text": "Liora veut goûter aux gâteaux : apporte-lui 3 gâteaux.",
		"type": "item", "item": "gateau", "n": 3, "reward": {"items": [["larme_esprit", 2]], "xp": 100},
		"start": [["liora", "Le pain, c'est bien. Mais on m'a parlé du GÂTEAU. Avec des œufs, du lait, du blé... Trois, s'il te plaît !"]],
		"wait": [["liora", "Gâteau, gâteau, gâteau ! Trois !"]],
		"end": [["liora", "Mmmmh ! Les fées vont être jalouses. Tiens, deux larmes de fée, pour toi."]]},
	{"id": "liora_b", "npc": "liora", "after": "fin", "title": "Les fées sauvages", "text": "Des fées sauvages ont perdu la tête : ramène-les à la raison (vaincs 8 fées sauvages ou esprits follets).",
		"type": "kill", "enemies": ["fee_sauvage", "esprit_follet"], "n": 8, "reward": {"items": [["larme_esprit", 3], ["cristal_aube", 1]], "xp": 450},
